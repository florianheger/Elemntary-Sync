# Copy to .env and fill in your credentials. See README.md.

# Dropbox (app key from the Dropbox App Console, refresh token from `auth-dropbox`)
DROPBOX_APP_KEY=
DROPBOX_REFRESH_TOKEN=
DROPBOX_WATCH_FOLDER=/Apps/WahooFitness

# Garmin Connect: no settings needed, log in once with `auth-garmin` (see README.md)

# Paths inside the container
FIT_CSV_TOOL_PATH=/app/FitCSVTool.jar
WORK_DIR=/data
